# Copy to .env. Relative paths resolve from the repository working directory.
TEACHAGENT_DATA=.data
ASR_MODEL_PATH=models/whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE=int8
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=2048
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Set to 1 when served over HTTPS on the school network.
COOKIE_SECURE=0
# Optional iFlytek IAT WebSocket service. Never commit real credentials.
# Each video still defaults to local ASR and requires consent to use cloud ASR.
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
