{
  "name": "teachagent-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "format": "prettier --write src e2e e2e-pages e2e-shared *.ts *.json",
    "format:check": "prettier --check src e2e e2e-pages e2e-shared *.ts *.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.3.5"
  }
}
