        "step": 1,
        "value": 10
      },
      {
        "key": "gravity",
        "label": "重力加速度",
        "unit": "m/s²",
        "min": 1,
        "max": 20,
        "step": 0.1,
        "value": 9.8
      }
    ]
  },
